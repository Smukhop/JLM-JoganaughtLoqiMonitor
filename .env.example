# ─── Core ──────────────────────────────────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── OAuth providers ───────────────────────────────────────────────────
# GitHub  → https://github.com/settings/developers
#   Callback: {AUTH_URL}/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Google  → https://console.cloud.google.com/apis/credentials
#   Callback: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── Database (Neon / Supabase / Vercel Postgres) ──────────────────────
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# ─── Model provider ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""
LOQI_MODEL_PRIMARY="claude-sonnet-4-5"
LOQI_MODEL_FAST="claude-haiku-4-5-20251001"

# ─── Army limits ───────────────────────────────────────────────────────
LOQI_MAX_CONCURRENCY="4"
LOQI_MAX_TASKS_PER_MISSION="24"
LOQI_TASK_TIMEOUT_MS="120000"

# ─── Cron ──────────────────────────────────────────────────────────────
# Bearer token Vercel sends to /api/missions/sweep. Set in production.
CRON_SECRET=""

# ─── Logging ───────────────────────────────────────────────────────────
# debug | info | warn | error   (default: info in prod, debug in dev)
LOQI_LOG_LEVEL=""

# ─── Optional: allowlist gating for members area ───────────────────────
# Comma-separated emails or domains (e.g. "@worley.com,me@gmail.com").
# Leave blank to allow any authenticated user.
LOQI_MEMBER_ALLOWLIST=""
