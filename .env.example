# Copy to .env.local for `vercel dev`, or set these in
# Vercel → Project → Settings → Environment Variables.
#
# Nothing here reaches the browser. /api/chat is the only reader.

# Required only for live chat. Without it the Studio runs the Simulacrum:
# deterministic, offline, zero network calls.
ANTHROPIC_API_KEY=

# Optional. The secure proxy default; it must remain in api/chat.js's allowlist.
# ANTHROPIC_MODEL=claude-sonnet-5

# Optional. Override the port tests/gate.mjs binds its static server to.
# GATE_PORT=4321

# Optional. Absolute path to a Chromium binary for tests/gate.mjs. Leave unset
# to use the one Playwright installs.
# CHROME_PATH=
