generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Auth.js core models ────────────────────────────────────────────────
// NOTE: session strategy is JWT (see auth.config.ts), so the Session table is
// unused at runtime. It is kept so you can switch to database sessions by
// changing one line — no migration required.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(MEMBER)
  createdAt     DateTime  @default(now())

  accounts      Account[]
  sessions      Session[]
  threads       Thread[]
  missions      Mission[]
  kbEntries     KbEntry[]
  artifacts     Artifact[]
}

enum Role {
  MEMBER
  OPERATOR
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── ChatStudio ─────────────────────────────────────────────────────────
model Thread {
  id        String    @id @default(cuid())
  userId    String
  title     String    @default("Untitled transmission")
  agentId   String    @default("sol-quasar")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId, updatedAt])
}

model Message {
  id        String   @id @default(cuid())
  threadId  String
  role      String   // user | assistant | system
  content   String   @db.Text
  agentId   String?
  tokensIn  Int      @default(0)
  tokensOut Int      @default(0)
  createdAt DateTime @default(now())

  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

// ── Agentic Army ───────────────────────────────────────────────────────
model Mission {
  id         String        @id @default(cuid())
  userId     String
  objective  String        @db.Text
  status     MissionStatus @default(PLANNING)
  plan       Json?
  report     String?       @db.Text
  tokensIn   Int           @default(0)
  tokensOut  Int           @default(0)
  toolCalls  Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks      Task[]
  artifacts  Artifact[]
  kbEntries  KbEntry[]

  @@index([userId, createdAt])
  @@index([status, updatedAt])
}

enum MissionStatus {
  PLANNING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model Task {
  id         String     @id @default(cuid())
  missionId  String
  agentId    String
  title      String
  brief      String     @db.Text
  dependsOn  String[]   @default([])
  status     TaskStatus @default(QUEUED)
  output     String?    @db.Text
  error      String?
  attempts   Int        @default(0)
  tokensIn   Int        @default(0)
  tokensOut  Int        @default(0)
  toolCalls  Int        @default(0)
  startedAt  DateTime?
  endedAt    DateTime?

  mission    Mission    @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([missionId, status])
}

enum TaskStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

// ── Knowledge base — the vault Kairo stewards ──────────────────────────
model KbEntry {
  id          String     @id @default(cuid())
  userId      String
  /** Destination world id, e.g. "itachi". Scopes retrieval. */
  world       String
  claim       String     @db.Text
  source      String?
  confidence  Confidence @default(MEDIUM)
  tags        String[]   @default([])
  /** Claim text or id this entry replaces, recorded rather than overwritten. */
  supersedes  String?
  committedBy String
  missionId   String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission     Mission?   @relation(fields: [missionId], references: [id], onDelete: SetNull)

  @@index([userId, world])
  @@index([userId, updatedAt])
}

enum Confidence {
  LOW
  MEDIUM
  HIGH
}

// ── Artefacts emitted by agents ────────────────────────────────────────
model Artifact {
  id        String   @id @default(cuid())
  userId    String
  missionId String?
  agentId   String
  filename  String
  language  String   @default("text")
  content   String   @db.Text
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission   Mission? @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([missionId])
}
