{
  "name": "loqi-omniverse",
  "version": "1.4.0",
  "private": true,
  "description": "Loqi Omniverse OS — a single-file WebGL omniverse, agentic Chat Studio and clearance gate, gated by an in-page BDD harness.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "check": "npm test",
    "test": "node tests/gate.mjs",
    "test:ci": "node tests/gate.mjs --headless",
    "shots": "node tests/surfaces.mjs",
    "predeploy": "npm run test",
    "deploy": "vercel deploy --prod"
  },
  "devDependencies": {
    "playwright": "^1.49.0"
  },
  "engines": { "node": ">=20 <23" }
}
