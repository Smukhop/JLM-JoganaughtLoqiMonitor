{
  "name": "loqi-omniverse",
  "version": "2.1.0",
  "private": true,
  "description": "Loqi Omniverse \u2014 Nine Worlds landing, OAuth membership, ChatStudio and the autonomous Agentic Army orchestrator.",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "verify": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "@auth/prisma-adapter": "^2.7.2",
    "@prisma/client": "^5.22.0",
    "clsx": "^2.1.1",
    "next": "^15.0.3",
    "next-auth": "^5.0.0-beta.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.0.3",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
